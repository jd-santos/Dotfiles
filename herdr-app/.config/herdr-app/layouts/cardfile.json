{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 300
      },
      "min": 44,
      "max": 560,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": {
            "px": 46
          },
          "window_drag": true,
          "content": {
            "mod": "workspace-chrome"
          }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "cf-spaces",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "cardfile",
                "props": {
                  "column": "spaces"
                }
              }
            },
            {
              "id": "cf-agents",
              "type": "block",
              "size": {
                "weight": 2
              },
              "min": 120,
              "content": {
                "mod": "cardfile",
                "props": {
                  "column": "agents"
                }
              }
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": {
            "px": 69
          },
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "tabs-row",
          "type": "row",
          "size": {
            "px": 42
          },
          "resizable": false,
          "children": [
            {
              "id": "tabs",
              "type": "block",
              "size": {
                "weight": 1
              },
              "window_drag": true,
              "content": {
                "mod": "tabs"
              }
            },
            {
              "id": "tabs-todo",
              "type": "block",
              "size": {
                "px": 160
              },
              "window_drag": true,
              "content": {
                "mod": "cardfile",
                "props": {
                  "column": "tab-button"
                }
              }
            }
          ]
        },
        {
          "id": "work-body",
          "type": "row",
          "padding": 8,
          "gap": 8,
          "children": [
            {
              "id": "center",
              "type": "stack",
              "active": "main",
              "children": [
                {
                  "id": "main",
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "gap": 8,
                      "radius": 10,
                      "background": "background",
                      "lone": true,
                      "border": {
                        "width": 1,
                        "color": "border"
                      },
                      "focus": {
                        "width": 1,
                        "color": "accent"
                      },
                      "header": {
                        "content": {
                          "mod": "pane"
                        },
                        "height": 30,
                        "position": "top",
                        "reveal": "always"
                      }
                    }
                  }
                },
                {
                  "id": "board",
                  "type": "block",
                  "content": {
                    "mod": "cardfile",
                    "props": {
                      "column": "board"
                    }
                  }
                }
              ]
            },
            {
              "id": "panel",
              "type": "column",
              "hidden": true,
              "size": {
                "px": 300
              },
              "min": 240,
              "max": 900,
              "children": [
                {
                  "id": "panel-tabs",
                  "type": "block",
                  "size": {
                    "px": 30
                  },
                  "content": {
                    "mod": "cardfile",
                    "props": {
                      "column": "panel-tabs"
                    }
                  }
                },
                {
                  "id": "panel-body",
                  "type": "stack",
                  "active": "files",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    },
                    {
                      "id": "todo",
                      "type": "block",
                      "content": {
                        "mod": "cardfile",
                        "props": {
                          "column": "todo"
                        }
                      }
                    }
                  ],
                  "padding": 6
                }
              ],
              "resizable": false,
              "gap": 0,
              "radius": 10,
              "background": "chrome",
              "border": {
                "width": 1,
                "color": "border"
              }
            }
          ]
        },
        {
          "id": "status",
          "type": "block",
          "size": {
            "px": 28
          },
          "content": {
            "mod": "workspace-status"
          }
        }
      ]
    }
  ],
  "theme": "cardfile"
}
