# --- Secrets & History ---
# NEVER commit files containing secrets, passwords, or shell history.
.env
.env.local
.env-local
**/.env-local
**/.env.local
.bash_history
.zsh_history

# --- System & OS-specific Files ---
# Ignore macOS, Windows, and local editor clutter.
.DS_Store
Thumbs.db

# ===================================================================
# --- Application-Specific Ignores ---
# Rules for specific applications, organized alphabetically.
# ===================================================================

# BoltAI
boltai/.boltai/


# VSCode (ignore extensions, runtime state, and workspace cache)
vscode/.vscode/extensions/
vscode/.vscode/argv.json
vscode/.vscode/globalStorage/
vscode/.vscode/workspaceStorage/

# Vim (ignore state, swap, and undo files)
vim/.vim/.netrwist
vim/.vim/.netrwhist
vim/.vim/*.swp
vim/.vim/*.un~

# Neovim (ignore plugin lockfile)
nvim/.config/nvim/lazy-lock.json

# ===================================================================
# --- Generic Cache & State Files ---
# Ignore common cache directories and specific state files.
# ===================================================================

# Generic cache used by many Node.js tools
config/.config/configstore/

# GitHub Copilot state
config/.config/github-copilot/versions.json

# Misc configs
config/.config/github-copilot
config/.config/raycast/
config/.config//gh/

# Pi lens cache
.pi-lens/

# Pi stow package local runtime files
# Herdr-generated agent integration, recreated by scripts/setup-herdr
pi/.pi/agent/extensions/herdr-agent-state.ts
pi/.pi/agent/auth.json
pi/.pi/agent/settings.json
pi/.pi/agent/settings.local.json
pi/.pi/agent/sessions/
pi/.pi/agent/bin/
pi/.pi/agent/mcp-cache.json
pi/.pi/agent/models-store.json
pi/.pi/agent/npm/

# Zed stow package generated settings
zed/.config/zed/settings.json
zed/.config/zed/settings.local.json
