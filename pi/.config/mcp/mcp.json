{
  "mcpServers": {
    "brave-search": {
      "command": "npx",
      "args": [
        "-y",
        "@brave/brave-search-mcp-server",
        "--transport",
        "stdio"
      ],
      "env": {
        "BRAVE_API_KEY": "${BRAVE_API_KEY}"
      }
    },
    "svelte": {
      "command": "npx",
      "args": ["-y", "@sveltejs/mcp"]
    },
    "xcode": {
      "command": "xcrun",
      "args": ["mcpbridge"],
      "env": {
        "DEVELOPER_DIR": "/Applications/Xcode-beta.app/Contents/Developer"
      },
      "lifecycle": "lazy"
    },
    "atlassian": {
      "command": "atlassian-mcp",
      "args": [],
      "lifecycle": "lazy",
      "idleTimeout": 10
    }
  }
}
